     which("cpio")
     which("find")
-    which("fakeroot")
+    # Real root can already create device nodes and set arbitrary
+    # ownership -- fakeroot is only needed (and only safe to rely on)
+    # for a non-root build. See lava-patch/0001-... for why this
+    # matters beyond redundancy in this image.
+    use_fakeroot = os.geteuid() != 0
+    if use_fakeroot:
+        which("fakeroot")
 
     try:
         find = subprocess.Popen(
@@ -142,10 +148,9 @@
             stdout=subprocess.PIPE,
         )
         with find:
-            # Use fakeroot to allow creation of device nodes and preserve ownership
             cpio = subprocess.run(
                 args=(
-                    "fakeroot",
+                    *(("fakeroot",) if use_fakeroot else ()),
                     "cpio",
                     "--create",
                     "--null",
@@ -171,12 +176,14 @@
 
